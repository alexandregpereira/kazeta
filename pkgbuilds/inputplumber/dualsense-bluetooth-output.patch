+    /// Writes the output state in the Bluetooth output report, which the controller ignores
+    /// unless it carries a sequence number and a CRC (as in the kernel's hid-playstation)
+    fn write_bluetooth(
+        &self,
+        state: SetStatePackedOutputData,
+    ) -> Result<(), Box<dyn Error + Send + Sync>> {
+        let sequence = self.output_sequence.fetch_add(1, Ordering::Relaxed) & 0x0f;
+        let mut buf = [0u8; OUTPUT_REPORT_BT_SIZE];
+        buf[0] = OUTPUT_REPORT_BT;
+        buf[1] = sequence << 4;
+        buf[2] = OUTPUT_REPORT_BT_TAG;
+        let state = state.pack()?;
+        buf[3..3 + state.len()].copy_from_slice(&state);
+        let crc_offset = OUTPUT_REPORT_BT_SIZE - 4;
+        let crc = crc32(&[&[OUTPUT_REPORT_BT_CRC_SEED], &buf[..crc_offset]]);
+        buf[crc_offset..].copy_from_slice(&crc.to_le_bytes());
+        let _bytes_written = self.device.write(&buf)?;
+
+        Ok(())
+    }
