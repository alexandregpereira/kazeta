+/// The hidraw device of a Bluetooth controller (created by BlueZ through uhid, with the Bluetooth
+/// bus 0005 in its HID id) can be reported before udev knows its name and IDs, and the device
+/// keeps the values it was reported with, so no config would ever match it. Read it again from
+/// sysfs for a moment until its IDs are there.
+async fn refresh_incomplete_bluetooth_hidraw(device: UdevDevice) -> UdevDevice {
+    const ATTEMPTS: u32 = 20;
+    const INTERVAL: Duration = Duration::from_millis(50);
+    if device.subsystem() != "hidraw"
+        || !device.devpath().contains("/uhid/0005:")
+        || device.id_vendor() != 0
+    {
+        return device;
+    }
+    let syspath = device.syspath();
+    for _ in 0..ATTEMPTS {
+        tokio::time::sleep(INTERVAL).await;
+        let Ok(udev_device) = ::udev::Device::from_syspath(std::path::Path::new(&syspath)) else {
+            continue;
+        };
+        let refreshed = UdevDevice::from(udev_device);
+        if refreshed.id_vendor() != 0 {
+            log::debug!(
+                "Bluetooth hidraw device {} was reported incomplete, read it again: {}",
+                refreshed.sysname(),
+                refreshed.name()
+            );
+            return refreshed;
+        }
+    }
+    log::warn!("Bluetooth hidraw device at {syspath} is still incomplete");
+    device
+}
